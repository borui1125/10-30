# ==========================================
# 資料庫連線環境變數設定範例
# 請複製此檔案為 .env 並填入實際資料庫連線資訊
# ==========================================

# PostgreSQL 連線字串 (使用 psycopg 驅動)
# 格式: postgresql+psycopg://<帳號>:<密碼>@<主機位址>:<連接埠>/<資料庫名稱>
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/event_db

# 亦可使用個別變數進行設定（若未設定 DATABASE_URL 則使用以下參數組合）
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=event_db
